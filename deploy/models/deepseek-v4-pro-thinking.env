# DeepSeek V4 Pro (0813) on 8 H200, as deepseek-v4-pro.env, for runs with thinking on (Think High,
# configs/models/modal-deepseek-v4-pro-thinking.yaml). Longer context: thinking answers are long.
DESCRIPTION="DeepSeek V4 Pro (0813), thinking on (high)"
MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
MODEL_REVISION=72e1d3230f6c080a530b0a1d46f8eb4602340597
TOOL_PARSER=deepseek_v4
REASONING_PARSER=deepseek_v4
GPU=H200:8
MAX_MODEL_LEN=32768
VLLM_ARGS="--tensor-parallel-size 8 --enable-expert-parallel --kv-cache-dtype fp8 --trust-remote-code --tokenizer-mode deepseek_v4"
STARTUP_MINUTES=60
MODEL_CONFIG=configs/models/modal-deepseek-v4-pro-thinking.yaml
