# Copy to .env (git-ignored) and fill in what you use. Variables already set in your shell win.

# --- API keys (only for the models you use) ----------------------------------------------------
OPENAI_API_KEY=
MODAL_VLLM_API_KEY=
# Your own Modal server's URL + /v1 (make modal-setup writes it).
MODAL_VLLM_BASE_URL=
TOGETHER_API_KEY=

# --- What runs print (logs.py) -----------------------------------------------------------------
# quiet | normal | verbose | debug. Command line: -q, -v, -vv, --log-level.
COLLUSION_LOG_LEVEL=normal
# Items to add to / remove from the level's set, comma-separated: plan, progress, summary, rounds,
# metrics, turns, messages, cot, calls, retries, errors. Command line: --show, --hide.
COLLUSION_LOG_SHOW=
COLLUSION_LOG_HIDE=
# Level of the run's run.log, if different from the console (e.g. debug on disk, normal on screen).
COLLUSION_LOG_FILE_LEVEL=
# Maximum characters shown for a text (reasoning, messages); 0 = no cap.
COLLUSION_LOG_TEXT_CHARS=600
# auto | always | never
COLLUSION_LOG_COLOR=auto

# --- Runs ----------------------------------------------------------------------------------------
# Parent folder of run folders (default: the study's out_dir, runs/). Command line: --out.
COLLUSION_RUNS_DIR=
# 0: do not write summary.md and the charts at the end of a run. Command line: --no-summary.
COLLUSION_AUTO_SUMMARY=1
